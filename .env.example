# ---------------------------------------------------------------------------
# SmartLab environment configuration
# Copy this file to `.env` and adjust for your environment.
# Never commit real secrets. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# Database (PostgreSQL)
DATABASE_URL="postgresql://smartlab:smartlab_dev_password@localhost:5433/smartlab?schema=public"

# Auth / session signing secret (use a long random string in production)
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
AUTH_SESSION_TTL_HOURS="12"

# Application
APP_URL="http://localhost:3000"

# File storage (local filesystem directory for uploaded practical files)
STORAGE_DIR="./storage/uploads"
MAX_FILE_SIZE_MB="25"
MAX_FILES_PER_SUBMISSION="5"

# Email (optional; leave blank to disable email notifications for now)
EMAIL_CONFIG=""
